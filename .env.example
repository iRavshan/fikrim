# Bu namuna fayl. Nusxa oling: cp .env.example .env
# .env HECH QACHON git'ga qo'shilmasin.

# Django maxfiy kaliti. Yangisini shu buyruq bilan yarating:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# PostgreSQL ma'lumotlar bazasi
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Production'da har doim False
DEBUG=False

# Vergul bilan ajratilgan domenlar. Production'da "*" ishlatmang.
ALLOWED_HOSTS=127.0.0.1,localhost
