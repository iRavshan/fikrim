# Bu namuna fayl. Nusxa oling: cp .env.example .env
# .env HECH QACHON git'ga qo'shilmasin.

# Django maxfiy kaliti. Yangisini shu buyruq bilan yarating:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# PostgreSQL ma'lumotlar bazasi
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Production'da har doim False
DEBUG=False

# Vergul bilan ajratilgan domenlar. Production'da "*" ishlatmang.
ALLOWED_HOSTS=127.0.0.1,localhost

# Vergul bilan ajratilgan, sxema bilan: https://misol.uz
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# QR kodlardagi havolalar shu manzildan quriladi
SITE_URL=http://127.0.0.1:8000

# Gemini API — fikrlarni avtomatik toifalash uchun.
# Bo'sh qoldirilsa toifalash ishlamaydi, hamma fikr "boshqa" ga tushadi.
GEMINI_API_KEY=

# ── Cloudflare R2 — bemor yuborgan rasmlar uchun ─────────────────────
# Bo'sh qoldirilsa rasmlar lokal diskka saqlanadi. Bu lokal ishlash uchun
# yetarli, lekin Railway'da fayl tizimi har deployda tozalanadi va
# rasmlar yo'qoladi — production'da bu qiymatlar to'ldirilishi SHART.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Cloudflare panelidagi S3 API manzili:
#   https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Bucket'ning ommaviy manzili, sxemasiz: pub-xxxxxxxx.r2.dev
R2_PUBLIC_DOMAIN=
